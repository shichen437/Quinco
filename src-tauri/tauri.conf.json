{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quinco",
  "version": "0.0.2",
  "identifier": "com.quinco.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9615",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quinco",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Quinco Development Root CA",
      "entitlements": null,
      "exceptionDomain": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMjkyODI0MkE1NzMxNUMKUldSY01WY3FKQ2dwc2swNWtha0Vzc1JmY1VhYXdRdkY5Ykx4b3BYVGxadzFoQnpJRUxqb01MMk8K",
      "endpoints": [
        "https://github.com/shichen437/Quinco/releases/latest/download/latest.json",
        "https://gitee.com/shichen437/Quinco/releases/latest/download/latest.json"
      ]
    }
  }
}
